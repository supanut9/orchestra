{
  "default": {
    "identifier": "default",
    "description": "Default capability set for Orchestra desktop app",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "shell:default",
      "shell:allow-execute",
      "shell:allow-spawn",
      "shell:allow-kill",
      "shell:allow-stdin-write",
      "shell:allow-open",
      "fs:default",
      "fs:allow-read",
      "fs:allow-write",
      "fs:allow-read-dir",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "fs:allow-read-text-file",
      "fs:allow-write-text-file",
      "fs:allow-create",
      "fs:allow-mkdir",
      "fs:allow-remove",
      "fs:allow-rename",
      "fs:allow-exists",
      "fs:allow-stat",
      "fs:allow-watch",
      "fs:allow-unwatch",
      "store:default",
      "store:allow-get",
      "store:allow-set",
      "store:allow-delete",
      "store:allow-save",
      "store:allow-load",
      "store:allow-keys",
      "store:allow-values",
      "store:allow-has",
      "dialog:default",
      "dialog:allow-open",
      "dialog:allow-save",
      "dialog:allow-message",
      "dialog:allow-ask",
      "dialog:allow-confirm"
    ]
  }
}

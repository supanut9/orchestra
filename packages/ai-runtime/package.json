{
  "name": "@orchestra/ai-runtime",
  "version": "0.0.0",
  "description": "Model-agnostic AI runtime — provider registry, agent loop, coordinator for parallel lanes",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./stream": {
      "import": "./dist/stream.js",
      "types": "./dist/stream.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ai": "catalog:",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai-compatible": "^0.2.0",
    "zod": "catalog:",
    "@langchain/langgraph": "^0.2.50",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsup": "^8.3.5",
    "vitest": "^4.1.6",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "rimraf": "^6.0.1"
  }
}
